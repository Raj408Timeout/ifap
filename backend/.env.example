# Copy to backend/.env. Nested settings use a DOUBLE underscore (IFAP_<SECTION>__<FIELD>).
# LLM: disabled | ollama | openai_compatible
IFAP_LLM__PROVIDER=ollama
IFAP_LLM__MODEL=qwen3:8b
# IFAP_LLM__ENABLED=true
# IFAP_LLM__TIMEOUT_SECONDS=180
# IFAP_LLM__API_KEY=sk-...           # openai_compatible only
# IFAP_LLM__BASE_URL=https://...     # openai_compatible only
